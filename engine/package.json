{
  "name": "@ruko/engine",
  "version": "0.1.0",
  "description": "On-device scam detection engine for India: UPI, KYC, digital arrest, job, investment and courier scams in English, Hindi and Hinglish. Zero dependencies.",
  "license": "MIT",
  "author": "Rutvi Rupani",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "scam",
    "fraud",
    "phishing",
    "upi",
    "india",
    "kyc",
    "digital-arrest",
    "hindi",
    "hinglish",
    "security",
    "on-device"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "npm run build && node scripts/bench.mjs",
    "size": "npm run build && node scripts/size.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}

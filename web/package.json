{
  "name": "ruko-web",
  "private": true,
  "version": "0.1.0",
  "description": "Ruko: India's on-device scam shield. Pause. Check. Then trust.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "node scripts/copy-ocr-assets.mjs && vite --port 5181 --strictPort",
    "dev:api": "tsx watch server/node.ts",
    "api": "tsx server/node.ts",
    "build": "node scripts/copy-ocr-assets.mjs && vite build && node scripts/check-bundle.mjs",
    "build:e2e": "node scripts/copy-ocr-assets.mjs && vite build --mode e2e && node scripts/check-bundle.mjs",
    "preview": "vite preview --port 5181 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "size": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "hono": "^4.13.13",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tesseract.js": "^7.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@hono/node-server": "^2.1.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1"
  }
}
